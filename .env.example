# Copy to .env and .env.local, fill in real values. Never commit the filled files.

# --- Web app (apps/web) ---
NEXT_PUBLIC_RISK_API_BASE_URL=http://localhost:8000
DEMO_MODE=true

# --- Risk service (services/risk) ---
RISK_MODEL_VERSION=v0.0.0-baseline

# --- Jev / TypeSafe (services/jev) — server-side only, never exposed to the client ---
JEV_API_KEY=
JEV_API_BASE_URL=https://api.typesafe.ai

# --- Earth Engine (scripts/data_pipeline) ---
# Path to a service-account JSON key. Keep this file OUTSIDE the repo tree.
GOOGLE_APPLICATION_CREDENTIALS=
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_PROJECT_ID=

# --- Supabase / PostGIS (optional, not required for demo mode) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
